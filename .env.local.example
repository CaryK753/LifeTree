# LifeTree local/private runtime foundation (desktop client not included).
#
# This profile prepares native data directories and system credential storage.
# PostgreSQL, Neo4j, Redis/Celery and MinIO adapters are still required by the
# current application until the local storage ports are implemented.

LIFETREE_STORAGE_MODE=local

# Optional portable override. Leave empty to use the native OS application
# data/config/cache directories. Never place this directory inside the repo.
LIFETREE_DATA_DIR=

# Local/private mode remains single-user only.
LIFETREE_USE_MODE=single
