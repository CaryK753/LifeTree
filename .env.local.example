# LifeTree local/private Alpha runtime (desktop packaging not included).
#
# This profile uses SQLite, content-addressed local files, and an in-process
# job runner. Embedded graph/vector adapters are not yet available.

LIFETREE_STORAGE_MODE=local

# Optional portable override. Leave empty to use the native OS application
# data/config/cache directories. Never place this directory inside the repo.
LIFETREE_DATA_DIR=

# Local/private mode remains single-user only.
LIFETREE_USE_MODE=single
