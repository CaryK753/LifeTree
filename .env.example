# ============================================================
# LifeTree 环境变量配置
# ============================================================
# 本文件仅包含【基础设施】连接配置。
# LLM / Tavily / Mineru / SMTP 等用户配置请在启动后的 WebUI
# 设置页面中配置，存储于数据库，支持热更新。
# ============================================================

# ==================== PostgreSQL ====================
POSTGRES_USER=lifetree
POSTGRES_PASSWORD=lifetree
POSTGRES_DB=lifetree
POSTGRES_HOST=localhost
POSTGRES_PORT=15432

# ==================== Neo4j ====================
NEO4J_USER=neo4j
NEO4J_PASSWORD=lifetree123
NEO4J_URI=bolt://localhost:17687
NEO4J_HTTP_PORT=17474
NEO4J_BOLT_PORT=17687

# ==================== Redis ====================
REDIS_HOST=localhost
REDIS_PORT=16379

# ==================== MinIO ====================
MINIO_ROOT_USER=lifetree
MINIO_ROOT_PASSWORD=lifetree123
MINIO_ENDPOINT=localhost:19000
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001
MINIO_BUCKET=lifetree-uploads

# ==================== 应用 ====================
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-in-production
APP_BACKEND_PORT=18000
APP_FRONTEND_PORT=13000
APP_CORS_ORIGINS=http://localhost:13000

# ==================== 使用模式与鉴权 ====================
# 使用模式：single（自用，单用户，无需登录）或 multi（多用户，需登录，管理员通过 LIFETREE_ADMIN_USER_IDS 提权）。
# 默认 single，保持现有部署兼容。仅首次启动时种子化；之后管理员可在设置页面切换。
LIFETREE_USE_MODE=single
# 提权为管理员的用户 ID 列表（逗号分隔）。在 /profile 页面查看用户 ID。
# 例：LIFETREE_ADMIN_USER_IDS=00000000-0000-0000-0000-000000000001,abc-123
LIFETREE_ADMIN_USER_IDS=
# 是否允许无 token 请求回退到默认用户（兼容单用户部署）。
# 设置为 false 后，所有 API 请求都必须带 Bearer token。
AUTH_ALLOW_DEFAULT_USER_FALLBACK=true
# JWT access token 有效期（分钟），默认 24 小时
AUTH_ACCESS_TOKEN_TTL_MINUTES=1440
# JWT refresh token 有效期（天），默认 30 天
AUTH_REFRESH_TOKEN_TTL_DAYS=30
