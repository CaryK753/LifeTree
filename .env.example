# ============================================================
# LifeTree 环境变量配置
# ============================================================
# 本文件仅包含【基础设施】连接配置。
# LLM / Tavily / Mineru / SMTP 等用户配置请在启动后的 WebUI
# 设置页面中配置，存储于数据库，支持热更新。
# ============================================================

# ==================== PostgreSQL ====================
POSTGRES_USER=lifetree
POSTGRES_PASSWORD=lifetree
POSTGRES_DB=lifetree
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ==================== Neo4j ====================
NEO4J_USER=neo4j
NEO4J_PASSWORD=lifetree123
NEO4J_URI=bolt://localhost:7687
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# ==================== Redis ====================
REDIS_HOST=localhost
REDIS_PORT=6379

# ==================== MinIO ====================
MINIO_ROOT_USER=lifetree
MINIO_ROOT_PASSWORD=lifetree123
MINIO_ENDPOINT=localhost:9000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=lifetree-uploads

# ==================== 应用 ====================
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-in-production
APP_BACKEND_PORT=8000
APP_FRONTEND_PORT=3000
APP_CORS_ORIGINS=http://localhost:3000
