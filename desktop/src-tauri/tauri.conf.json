{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LifeTree",
  "version": "0.2.3",
  "identifier": "com.lifetree.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://127.0.0.1:1420/launcher/",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "bootstrap",
        "url": "launcher/index.html",
        "title": "LifeTree",
        "width": 640,
        "height": 760,
        "minWidth": 480,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "visible": false,
        "backgroundColor": "#0f1410"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob: https:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:* https://api.github.com https:"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "externalBin": ["binaries/lifetree-sidecar"],
    "resources": ["resources/sidecar-runtime/**/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIyRTc3MUZDRERCNjQ2ODUKUldTRlJyYmQvSEhuSWpXMWlEbVAwWk5FUU9wOENQMW4yMVU4My9oMkRzVWcvMmcwa3c3Y2JhNUoK",
      "endpoints": [
        "https://github.com/CaryK753/LifeTree/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
